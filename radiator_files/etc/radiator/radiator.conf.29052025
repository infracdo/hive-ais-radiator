# Reject everything else
#<Handler>
#    Identifier default-handler
#
#    <AuthBy INTERNAL>
#        Identifier auth-internal-reject
#        AuthResult   REJECT
#        AcctResult   ACCEPT
#
#        # This sets reject reason for AuthLog
#        RejectReason Handled and rejected by default-handler
#    </AuthBy>
#
