<SessionDatabase SQL>
    Identifier mysessiondb
    DBSource    dbi:Pg:dbname=radius;host=localhost;port=5432
    DBUsername  radiator
    DBAuth      ap0ll0ap0ll0

    AddQuery INSERT INTO sessions (UserName, NASIPAddress, NASPort, AcctSessionId, AcctStartTime) VALUES (%0,'%1', %2, %3, NOW())
    DeleteQuery DELETE FROM sessions WHERE UserName=%0 AND AcctSessionId=%3
    GetSessionQuery SELECT NASIPAddress, AcctSessionId FROM sessions WHERE UserName=%0
</SessionDatabase>


<Handler Client-Identifier=default-client>
    Identifier ap-handler

    <AuthBy SQL>
        Identifier auth-sql

        DBSource    dbi:Pg:dbname=radius;host=localhost;port=5432
        DBUsername  radiator
        DBAuth      ap0ll0ap0ll0
    
        AuthSelect select PASSWORD from SUBSCRIBERS where USERNAME=%0
        #AuthSelect select PASSWORD, REMAINING_SESSION_TIME from SUBSCRIBERS where USERNAME=%0 and REMAINING_SESSION_TIME>0
        #AuthSelect select PASSWORD, REMAINING_BYTES from SUBSCRIBERS where USERNAME=%0 and REMAINING_BYTES>0
        AuthColumnDef 0, User-Password, check
        #AuthColumnDef 1, Session-Timeout, reply
        #AuthColumnDef 1, max-up-rate, reply

        EAPType PEAP, MSCHAP-V2
        EAPTLS_CAFile /etc/radiator/certs/ca.pem
        EAPTLS_CertificateFile /etc/radiator/certs/server.pem
        EAPTLS_CertificateType PEM
        EAPTLS_PrivateKeyFile /etc/radiator/certs/server.key
        EAPTLS_PrivateKeyPassword whatever
        EAPTLS_MaxFragmentSize 1000
        EAPTLS_PEAPVersion 0
        EAPTLS_SessionResumption 0
        AutoMPPEKeys

        HandleAcctStatusTypes Start,Stop,Alive
      
        AccountingTable ACCOUNTING
        AcctColumnDef   USERNAME,User-Name
        AcctColumnDef   TIME_STAMP,Timestamp,integer
        AcctColumnDef   ACCTSTATUSTYPE,Acct-Status-Type
        AcctColumnDef   ACCTDELAYTIME,Acct-Delay-Time,integer
        AcctColumnDef   CALLED_STATION_ID,Called-Station-Id
        AcctColumnDef   CALLING_STATION_ID,Calling-Station-Id
        AcctColumnDef   ACCTINPUTOCTETS,Acct-Input-Octets,integer
        AcctColumnDef   ACCTOUTPUTOCTETS,Acct-Output-Octets,integer
        #AcctColumnDef   ACCTSESSIONID,Callback-Id
        AcctColumnDef   ACCTSESSIONID,Acct-Session-Id
        AcctColumnDef   ACCTSESSIONTIME,Acct-Session-Time,integer 
        AcctColumnDef   ACCTTERMINATECAUSE,Acct-Terminate-Cause
        AcctColumnDef   NASIDENTIFIER,NAS-Identifier
        AcctColumnDef   NASPORT,NAS-Port,integer
        AcctColumnDef   FRAMEDIPADDRESS,Framed-IP-Address
        AcctColumnDef   AUTH_MODE,Login-LAT-Service
        AcctColumnDef   DEVICE,Connect-Info
        AcctColumnDef   MAC,Login-LAT-Node

        #AcctSQLStatement update SUBSCRIBERS set REMAINING_SESSION_TIME=GREATEST(REMAINING_SESSION_TIME-%{Acct-Session-Time},0) WHERE USERNAME=%0;
        #AcctSQLStatement update SUBSCRIBERS set remaining_bytes=GREATEST(remaining_bytes-(%{Acct-Input-Octets}+%{Acct-Output-Octets}),0) WHERE USERNAME=%0;	

        SQLRecoveryFile %D/missedaccounting
        #Acct-Interim-Interval = 5
     </AuthBy>
     SessionDatabase mysessiondb
     #AcctInsertOrderedFields User-Name,Acct-Session-Id,NAS-IP-Address,Framed-IP-Address
</Handler>

# DYNAUTH Listener (CoA/Disconnect-Request handler)
<ServerRADSEC>
    BindAddress 0.0.0.0
    Port 3799
</ServerRADSEC>

<AuthBy DYNAUTH>
    Identifier dynauth
    SessionDatabase mysessiondb
</AuthBy>

# Handler to forward DYNAUTH Disconnect to NAS
<Handler DynAuthRequest=1>
    <AuthBy RADIUS>
        Identifier sendtoap
        Host 192.168.90.188
        Secret ap0ll0
        AuthPort 3799  
        RetryTimeout 5
        Retries 3
    </AuthBy>
</Handler>

# Accounting
<Handler>
        AuthLog authlog-sql
        <AuthBy SQL>
                DBSource        dbi:Pg:dbname=radius;host=localhost;port=5432
                DBUsername      radiator
                DBAuth          ap0ll0ap0ll0

                NoDefault

                AccountingTable ACCOUNTING
                AcctColumnDef   USERNAME,User-Name
                AcctColumnDef   TIME_STAMP,Timestamp,integer
                AcctColumnDef   ACCTSTATUSTYPE,Acct-Status-Type
                AcctColumnDef   ACCTDELAYTIME,Acct-Delay-Time,integer
                AcctColumnDef   ACCTINPUTOCTETS,Called-Station-Id
                AcctColumnDef   ACCTOUTPUTOCTETS,Calling-Station-Id
                #AcctColumnDef   ACCTINPUTOCTETS,Acct-Input-Octets,integer
                #AcctColumnDef   ACCTOUTPUTOCTETS,Acct-Output-Octets,integer
                #AcctColumnDef   ACCTSESSIONID,Acct-Session-Id
                #AcctColumnDef   ACCTSESSIONID,Framed-MTU
                AcctColumnDef   ACCTSESSIONID,Callback-Id
                AcctColumnDef   ACCTSESSIONTIME,Acct-Session-Time,integer
                AcctColumnDef   ACCTTERMINATECAUSE,Acct-Terminate-Cause
                AcctColumnDef   NASIDENTIFIER,NAS-Identifier
                AcctColumnDef   NASPORT,NAS-Port,integer
                AcctColumnDef   FRAMEDIPADDRESS,Framed-IP-Address
                AcctColumnDef   AUTH_MODE,Login-LAT-Service
                AcctColumnDef   DEVICE,Connect-Info
                AcctColumnDef   MAC,Login-LAT-Node

                SQLRecoveryFile %D/missedaccounting

                EAPType     MSCHAP-V2
        </AuthBy>
</Handler>
